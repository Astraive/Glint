{
  "$schema": "../../../schemas/glint-tokens-v1.schema.json",
  "$comment": "Default-theme values for the semantic token contract (THM-004, docs/architecture/design-tokens.md). Neutral graphite, silver and white; no green. Every colour pair listed in CONTRAST_REQUIREMENTS meets WCAG AA in both schemes.",
  "schemaVersion": 1,
  "colorSchemes": {
    "dark": {
      "background.default": "#141518",
      "background.subtle": "#1b1c20",
      "surface.default": "#1b1c20",
      "surface.raised": "#24262b",
      "surface.overlay": "#2e3036",
      "text.primary": "#f5f6f7",
      "text.secondary": "#c4c7cd",
      "text.muted": "#a9adb5",
      "text.on-accent": "#141518",
      "border.subtle": "#2e3036",
      "border.default": "#3b3e45",
      "accent.default": "#c4c7cd",
      "accent.subtle": "#3b3e45",
      "focus.ring": "#dcdee2"
    },
    "light": {
      "background.default": "#ebecee",
      "background.subtle": "#f5f6f7",
      "surface.default": "#f5f6f7",
      "surface.raised": "#ffffff",
      "surface.overlay": "#ffffff",
      "text.primary": "#141518",
      "text.secondary": "#3b3e45",
      "text.muted": "#5b5f68",
      "text.on-accent": "#f5f6f7",
      "border.subtle": "#dcdee2",
      "border.default": "#c4c7cd",
      "accent.default": "#3b3e45",
      "accent.subtle": "#dcdee2",
      "focus.ring": "#2e3036"
    }
  },
  "tokens": {
    "font.family.base": "system-ui, \"Segoe UI\", Ubuntu, Cantarell, \"Noto Sans\", sans-serif",
    "font.family.mono": "ui-monospace, \"Cascadia Mono\", Consolas, Menlo, monospace",
    "font.size.small": "12px",
    "font.size.base": "13px",
    "font.size.large": "15px",
    "font.weight.regular": 400,
    "font.weight.strong": 600,
    "font.line-height.base": 1.4,
    "space.xs": "4px",
    "space.sm": "8px",
    "space.md": "12px",
    "space.lg": "16px",
    "space.xl": "24px",
    "radius.sm": "4px",
    "radius.md": "8px",
    "radius.lg": "12px",
    "border.width": "1px",
    "focus.width": "2px",
    "focus.offset": "2px",
    "elevation.low": "0 1px 2px #00000066",
    "elevation.medium": "0 4px 12px #00000073",
    "elevation.high": "0 12px 32px #00000099",
    "motion.duration.fast": "100ms",
    "motion.duration.normal": "160ms",
    "motion.duration.slow": "280ms",
    "motion.easing.standard": "cubic-bezier(0.2, 0, 0, 1)",
    "motion.easing.emphasized": "cubic-bezier(0.3, 0, 0, 1)",
    "panel.height": "36px"
  }
}
