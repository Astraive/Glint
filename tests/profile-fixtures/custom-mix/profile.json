{
  "$schema": "../../../schemas/glint-profile-v1.schema.json",
  "schemaVersion": 1,
  "id": "profile.custom-mix",
  "name": "Custom Mix",
  "baseTheme": { "id": "official.mono", "version": "1.0.0" },
  "surfaces": {
    "dock": { "theme": "community.glassdock", "version": "1.1.0" },
    "notification": { "theme": "me.minimal-notifs", "version": "0.4.0" }
