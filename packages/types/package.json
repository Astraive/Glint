{
  "name": "@glint/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Glint TypeScript types. src/surfaces.ts is generated from crates/glint-surfaces (PROPOSED format).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./surfaces": "./src/surfaces.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3"
  }
}
